+/* FastMD: Upstream starts a table only if the header row is the sole line of the
+ * paragraph. As in GFM, let a table interrupt a longer paragraph too, provided
+ * the last line of it is a header row of the matching width. */
+static int
+md_can_start_table(MD_CTX* ctx, const MD_LINE_ANALYSIS* underline, unsigned col_count)
+{
+    const MD_LINE* lines = (const MD_LINE*) (ctx->current_block + 1);
+    MD_SIZE n_lines = ctx->current_block->n_lines;
+
+    if(n_lines == 1)
+        return TRUE;
+
+    return (underline->indent < ctx->code_indent_offset  &&
+            md_table_header_col_count(ctx, lines[n_lines-1].beg, lines[n_lines-1].end) == col_count);
+}
