+/* FastMD: Count cells of a potential table header row. As in cmark-gfm, only a
+ * backslash protects '|' (a code span does not), so the count is never lower
+ * than what md_process_table_row() finds and no cell can be dropped. */
+static unsigned
+md_table_header_col_count(MD_CTX* ctx, OFF beg, OFF end)
+{
+    unsigned col_count = 0;
+    OFF off;
+
+    while(beg < end  &&  ISWHITESPACE(beg))
+        beg++;
+    while(end > beg  &&  ISWHITESPACE(end-1))
+        end--;
+
+    if(beg < end  &&  CH(beg) == _T('|')) {
+        beg++;
+        while(beg < end  &&  ISWHITESPACE(beg))
+            beg++;
+    }
+
+    while(beg < end) {
+        off = beg;
+        while(off < end  &&  CH(off) != _T('|'))
+            off += (CH(off) == _T('\\')) ? 2 : 1;
+        col_count++;
+        beg = off + 1;
+    }
+
+    return col_count;
+}
